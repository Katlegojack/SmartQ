# Smart Q production environment example.
# Copy to your deployment platform's secret/config store. Do not commit real secrets.

SMARTQ_ENV=production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
ALLOWED_HOSTS=api.example.com

# Production PostgreSQL. If DATABASE_URL is absent, Smart Q continues to use
# the existing local SQLite database.
DATABASE_URL=postgresql://user:password@host/database
# SMARTQ_SQLITE_PATH=/app/data/db.sqlite3

# Frontend/API origin policy. Use exact scheme + host + optional port values.
# Example for a separately hosted frontend:
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true

# Session/CSRF cookie policy.
# Keep Lax for same-site deployments. If frontend and API are genuinely cross-site,
# review browser cookie requirements before changing to None; Secure must remain true.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# HTTPS / reverse proxy
SECURE_SSL_REDIRECT=true
USE_X_FORWARDED_PROTO=true
SECURE_HSTS_SECONDS=3600

# Enable these only when every subdomain is HTTPS-only and the HSTS preload
# commitment has been reviewed.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

LOG_LEVEL=INFO


# Machine-learning wait prediction.
# true: use the packaged XGBoost model when the live queue state is inside the
# validated training domain; SmartQ still falls back to deterministic ETA.
# false: disable ML predictions without changing application code.
SMARTQ_ML_ENABLED=true

# Presentation demo bootstrap. Keep false/unset outside an intentional demo deployment.
SMARTQ_ALLOW_DEMO_BOOTSTRAP=false
SMARTQ_DEMO_PASSWORD=replace-with-a-demo-only-password
